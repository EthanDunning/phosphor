            "id": "advanced-options",
            "type": "screen",
            "content": [
                {
                    "type": "text",
                    "className": "alert",
                    "text": "SECTION: ADVANCED OPTIONS"
                },
                "",
                "Useful optional properties:",
                "- speed (per-element typing speed)",
                "- defaultTextSpeed (screen or config level)",
                "- loop (repeat object elements N times)",
                "- onDone (auto-advance with optional delayMs)",
                "- allowFreeInput + inputAction + caseSensitive on prompts",
                "- fillWidth / scale / animated for bitmap/image",
                "- align: \"left\" | \"center\" | \"right\" | \"justify\" (any element)",
                "",
                {
                    "type": "text",
                    "className": "notice",
                    "text": "This line is align=center.",
                    "align": "center"
                },
                {
                    "type": "text",
                    "className": "notice",
                    "text": "This line is align=right.",
                    "align": "right"
                },
                "",
                "Slow line:",
                {
                    "type": "text",
                    "text": "SYSTEM CHECK...",
                    "speed": 0.25
                },
                "Fast line:",
                {
                    "type": "text",
                    "text": "CHECK COMPLETE.",
                    "speed": 4
                },
                "Loop separator:",
                {
                    "type": "text",
                    "text": "-",
