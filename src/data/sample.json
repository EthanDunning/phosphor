            "content": [
                {
                    "type": "text",
                    "className": "alert",
                    "text": "SECTION: SCRIPT STRUCTURE"
                },
                "",
                "Top-level shape:",
                "{",
                "  \"config\": { \"name\": \"My Script\", \"author\": \"You\" },",
                "  \"screens\": [ ... ],",
                "  \"dialogs\": [ ... ]",
                "}",
                "",
                "Screen shape:",
                "{",
                "  \"id\": \"unique-id\",",
                "  \"type\": \"screen\" | \"static\" | \"filesystem\",",
                "  \"content\": [ ... ],",
                "  \"onDone\": { \"target\": \"next-id\", \"delayMs\": 1200 },",
                "  \"headerTitle\": \"...\"   (filesystem title bar text)",
                "}",
                "",
                "screen = progressive render, static = immediate render",
                "filesystem = three-region file browser (see FILE SYSTEM SCREENS)",
