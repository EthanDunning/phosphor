        {
            "id": "using-app",
            "type": "screen",
            "content": [
                {
                    "type": "text",
                    "className": "alert",
                    "text": "SECTION: USING THE APP"
                },
                "",
                "Core header controls:",
                "- SCRIPT: switch bundled/custom/module scripts",
                "- MODULES: manage your own and subscribed modules",
                "- CREATOR: edit the active script or start a script",
                "- RELOAD: restart the active script runtime from the beginning",
                "- RESET: clear broader local app state (more aggressive)",
                "- THEME + SOUND controls",
                "",
                "Preview mode details:",
                "- Header shows [PREVIEW MODE] + [RETURN TO CREATOR]",
                "- Flow runs in the real terminal renderer",
                "- Use it before publishing modules",
                "",
                {
                    "type": "link",
                    "text": "> KEYBOARD SHORTCUTS",
                    "target": "keybinds"
                },
                {
                    "type": "link",
                    "text": "> NEXT: MODULES + LIBRARY WORKFLOW",
                    "target": "modules-workflow"
                },
                {
                    "type": "link",
                    "text": "> TABLE OF CONTENTS",
                    "target": "hub"
                }
            ]
        },
        {
            "id": "keybinds",
            "type": "screen",
            "content": [
                {
                    "type": "text",
                    "className": "alert",
                    "text": "SECTION: KEYBOARD SHORTCUTS"
                },
                "",
                "Every shortcut the app listens for.",
                "Shortcuts are ignored while text is being entered: in a terminal",
                "prompt or login, and in any text field (script creator, library",
                "search, report composer).",
                "",
                {
                    "type": "text",
                    "className": "system",
                    "text": "[APP]"
                },
                "Shift + H .......... show / hide the top header bar",
                "",
                {
                    "type": "text",
                    "className": "system",
                    "text": "[TERMINAL]"
                },
                "Shift + Space ...... skip the typing animation on the current screen",
                "Ctrl + Shift + L ... bypass a login on the current screen; submits",
                "                     the login's first credential, so it lands on",
                "                     whatever that credential targets. Does nothing",
                "                     on a screen without a login.",
                "",
                {
                    "type": "text",
                    "className": "system",
                    "text": "[PROMPTS]"
                },
                "letters / numbers .. enter text",
                "Backspace .......... delete the last character",
                "Enter .............. submit the command",
                "",
                {
                    "type": "text",
                    "className": "system",
                    "text": "[LOGIN PROMPTS]"
                },
                "letters / numbers .. enter text",
                "Enter .............. submit the username, then the password",
                "Backspace .......... delete the last character",
                "",
                {
                    "type": "text",
                    "className": "system",
                    "text": "[DIALOGS]"
                },
                "Escape ............. close the dialog",
                "Enter .............. close the dialog (when it has no action buttons)",
                "",
                {
                    "type": "text",
                    "className": "system",
                    "text": "[FILE SYSTEM SCREENS]"
                },
                "Up / Down .......... move within the focused list",
                "Left / Right ....... switch between the folder list and the file list",
                "Enter .............. open a folder's files, or activate a button",
                "Home / End ......... jump to the first / last entry",
                "Backspace / Esc .... return focus from the file list to the folder list",
                "",
                {
                    "type": "text",
                    "className": "system",
                    "text": "[MOUSE]"
                },
                "Shift + click ...... alternate action on a link, toggle, or list,",
                "                     where the script defines one",
                "Press and hold ..... same as Shift + click, for touch screens",
                "",
                {
                    "type": "link",
                    "text": "> PREVIOUS: USING THE APP",
                    "target": "using-app"
                },
                {
                    "type": "link",
                    "text": "> TABLE OF CONTENTS",
                    "target": "hub"
                }
            ]
        },
